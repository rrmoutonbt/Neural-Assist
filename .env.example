# =============================================================
# Banc of El - Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# =============================================================

# --- MongoDB ---
MONGO_ROOT_USER=bancadmin
MONGO_ROOT_PASSWORD=changeme_mongo_root
MONGO_APP_USER=bancapp
MONGO_APP_PASSWORD=changeme_mongo_app
MONGO_DB=banc_of_el

# --- PostgreSQL ---
POSTGRES_USER=opendoor
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=opendoor_deals

# --- Redis ---
REDIS_PASSWORD=changeme_redis

# --- JWT ---
JWT_SECRET=changeme_generate_with_openssl_rand_hex_64
JWT_EXPIRES_IN=24h

# --- SMTP / SendGrid ---
SENDGRID_API_KEY=changeme_sendgrid_key
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
EMAIL_FROM=Banc of El <admin@banc-of-el-trust-international.org>

# --- App ---
NODE_ENV=production
CLIENT_URL=https://banc-of-el-trust-international.org
CORS_ORIGINS=https://banc-of-el-trust-international.org

# --- Neural Assistant ---
NEURAL_JWT_SECRET=changeme_generate_with_openssl_rand_hex_64
ANTHROPIC_API_KEY=changeme_anthropic_key
