# Copy to .env before `docker compose up`. Committed values are safe
# defaults; everything sensitive (Schwab tokens) belongs elsewhere
# (a secrets manager, /etc/ladderbot/env with 0600 perms, or the
# broker package's token_provider callable — never in this file).

# Host-side port for the API + UI.
LADDER_HOST_PORT=5000

# Where the pipeline runner reads/writes.
LADDER_BAR_SOURCE=synthetic   # synthetic | yfinance

# Comma-separated origin allowlist. Set to a specific hostname in
# production, e.g. https://ladder.example.com
LADDER_CORS_ORIGINS=*

# Gunicorn tuning. Bump WORKERS to (2 x vCPU) + 1 on a larger box.
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
