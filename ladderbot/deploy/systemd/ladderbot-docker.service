[Unit]
Description=LadderBot Trading Engine (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/banc-of-el
ExecStart=/usr/bin/docker compose up -d ladderbot
ExecStop=/usr/bin/docker compose stop ladderbot
ExecReload=/usr/bin/docker compose restart ladderbot
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
