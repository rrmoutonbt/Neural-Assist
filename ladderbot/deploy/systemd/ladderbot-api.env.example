# /etc/ladderbot/ladderbot-api.env — mode 0640, owner root:ladder.
# Nothing sensitive belongs here; token_provider callable in code
# handles Schwab OAuth flows.

LADDER_API_PORT=5000
LADDER_DB_PATH=/var/lib/ladderbot/ladder.db
LADDER_REPORT_DIR=/var/lib/ladderbot/out/ladder_run
LADDER_BAR_SOURCE=synthetic
LADDER_CORS_ORIGINS=https://ladder.example.com

GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
